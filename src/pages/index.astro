---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ToolCard from "../components/ToolCard.astro";
---

<BaseLayout
  title="NH Deserves Better"
  description="Tools and resources for civic engagement and accountability in New Hampshire."
>

<Hero
  title="Civic engagement should be accessible."
  description="Track legislation, understand how representatives are voting, connect with organizing opportunities, and take meaningful action in your community."
  buttonText="Find Your Representatives"
  buttonLink="/tools/my-state-rep"
/>

  <div class="container">

    <h2>Featured Tools</h2>

    <div class="tool-grid">

      <ToolCard
        title="My State Rep"
        description="Find your representatives and understand how they’re voting."
        link="/tools/my-state-rep"
      />

      <ToolCard
        title="Bill Tracker"
        description="Track important legislation and community testimony."
        link="/tools/bill-tracker"
      />

      <ToolCard
        title="Accountability"
        description="Explore voting records and legislative accountability."
        link="/tools/accountability"
      />

    </div>

  </div>
</section>

<style>
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

</BaseLayout>