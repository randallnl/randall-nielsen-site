---
const API_BASE =
  import.meta.env.PUBLIC_API_BASE ||
  "https://api.nhdeservesbetter.com";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>My State Rep | NH Deserves Better</title>

    <style>
      :root {
        --bg: #0f1115;
        --panel: #171a21;
        --border: #2a2f3a;
        --text: #f5f7fb;
        --muted: #b2bac7;
        --accent: #8ab4ff;
        --accent-hover: #a7c5ff;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, system-ui, sans-serif;
        line-height: 1.5;
      }

      .container {
        width: min(1100px, calc(100% - 2rem));
        margin: 0 auto;
      }

      .hero {
        padding: 4rem 0 2rem;
      }

      .hero h1 {
        font-size: clamp(2rem, 5vw, 4rem);
        line-height: 1;
        margin: 0 0 1rem;
      }

      .hero p {
        max-width: 700px;
        color: var(--muted);
        font-size: 1.1rem;
      }

      .lookup-box {
        margin-top: 2rem;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 1rem;
        padding: 1.5rem;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      label {
        font-weight: 600;
      }

      input {
        width: 100%;
        padding: 1rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border);
        background: #0f131a;
        color: var(--text);
        font-size: 1rem;
      }

      input:focus {
        outline: 2px solid var(--accent);
        border-color: var(--accent);
      }

      button {
        width: fit-content;
        border: none;
        background: var(--accent);
        color: black;
        padding: 0.9rem 1.2rem;
        border-radius: 0.75rem;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease;
      }

      button:hover {
        background: var(--accent-hover);
      }

      .helper {
        color: var(--muted);
        font-size: 0.95rem;
      }

      .status {
        margin-top: 1rem;
        color: var(--muted);
      }

      .results {
        margin-top: 2rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1rem;
      }

      .card {
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 1rem;
        overflow: hidden;
      }

      .card-top {
        display: flex;
        gap: 1rem;
        padding: 1rem;
      }

      .photo {
        width: 96px;
        height: 96px;
        border-radius: 0.75rem;
        object-fit: cover;
        background: #222834;
        flex-shrink: 0;
      }

      .card-body {
        flex: 1;
      }

      .card h2 {
        margin: 0;
        font-size: 1.25rem;
      }

      .meta {
        color: var(--muted);
        margin-top: 0.25rem;
        font-size: 0.95rem;
      }

      .pill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 0.75rem;
      }

      .pill {
        background: #232937;
        color: var(--text);
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        font-size: 0.85rem;
      }

      .contact {
        border-top: 1px solid var(--border);
        padding: 1rem;
      }

      .contact a {
        color: var(--accent);
        text-decoration: none;
      }

      .contact a:hover {
        text-decoration: underline;
      }

      .section-title {
        margin-top: 3rem;
        margin-bottom: 1rem;
        font-size: 1.5rem;
      }

      .empty-photo {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #7b8496;
        font-size: 0.85rem;
        text-align: center;
      }

      @media (max-width: 640px) {
        .card-top {
          flex-direction: column;
          align-items: center;
          text-align: center;
        }

        .pill-row {
          justify-content: center;
        }
      }
    </style>
  </head>

  <body>
    <main class="container">
      <section class="hero">
        <h1>Find Your State Representatives</h1>

        <p>
          Enter your address to identify your New Hampshire state legislators,
          view district information, and connect directly with the people
          representing your community.
        </p>

        <div class="lookup-box">
          <form id="lookup-form">
            <div>
              <label for="address">Your full address</label>
            </div>

            <input
              id="address"
              name="address"
              type="text"
              required
              placeholder="123 Main St, Manchester, NH"
              autocomplete="street-address"
            />

            <div class="helper">
              Your address is used only to identify legislative districts. It
              is not stored by this website.
            </div>

            <button type="submit">Find My Representatives</button>
          </form>

          <div id="status" class="status"></div>
        </div>

        <div id="results"></div>
      </section>
    </main>

    <script define:vars={{ API_BASE }}>
      const form = document.getElementById("lookup-form");
      const resultsEl = document.getElementById("results");
      const statusEl = document.getElementById("status");

      function escapeHtml(str = "") {
        return String(str)
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function createRepCard(rep) {
        const photo = rep.photo
          ? `
            <img
              class="photo"
              src="${escapeHtml(rep.photo)}"
              alt="${escapeHtml(rep.name)}"
            />
          `
          : `
            <div class="photo empty-photo">
              No Photo
            </div>
          `;

        const email = rep.email
          ? `
            <div>
              <strong>Email:</strong>
              <a href="mailto:${escapeHtml(rep.email)}">
                ${escapeHtml(rep.email)}
              </a>
            </div>
          `
          : "";

        const phone = rep.phone
          ? `
            <div style="margin-top: 0.5rem;">
              <strong>Phone:</strong>
              ${escapeHtml(rep.phone)}
            </div>
          `
          : "";

        const notes = rep.notes
          ? `
            <div style="margin-top: 0.75rem; color: #b2bac7;">
              ${escapeHtml(rep.notes)}
            </div>
          `
          : "";

        return `
          <article class="card">
            <div class="card-top">
              ${photo}

              <div class="card-body">
                <h2>${escapeHtml(rep.name)}</h2>

                <div class="meta">
                  ${escapeHtml(rep.chamber)}
                </div>

                <div class="pill-row">
                  <div class="pill">
                    ${escapeHtml(rep.party || "Unknown")}
                  </div>

                  <div class="pill">
                    District ${escapeHtml(rep.district || "")}
                  </div>
                </div>

                <div class="meta" style="margin-top: 0.75rem;">
                  ${escapeHtml(rep.location_text || "")}
                </div>
              </div>
            </div>

            <div class="contact">
              ${email}
              ${phone}
              ${notes}
            </div>
          </article>
        `;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const address = document
          .getElementById("address")
          .value
          .trim();

        if (!address) return;

        statusEl.textContent = "Looking up representatives...";
        resultsEl.innerHTML = "";

        try {
          const response = await fetch(`${API_BASE}/reps/lookup`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ address }),
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.error || "Lookup failed.");
          }

          const normalized = data.normalizedInput || {};

          const prettyAddress = [
            normalized.line1,
            normalized.city,
            normalized.state,
            normalized.zip,
          ]
            .filter(Boolean)
            .join(", ");

          statusEl.textContent = prettyAddress
            ? `Showing results for: ${prettyAddress}`
            : "";

          if (
            !data.representatives ||
            data.representatives.length === 0
          ) {
            statusEl.textContent =
              "No representatives found for that address.";
            return;
          }

          const senateCards = (data.groups?.senate || [])
            .map(createRepCard)
            .join("");

          const houseCards = (data.groups?.house || [])
            .map(createRepCard)
            .join("");

          resultsEl.innerHTML = `
            ${
              senateCards
                ? `
                <section>
                  <h2 class="section-title">State Senate</h2>
                  <div class="results">
                    ${senateCards}
                  </div>
                </section>
              `
                : ""
            }

            ${
              houseCards
                ? `
                <section>
                  <h2 class="section-title">State House</h2>
                  <div class="results">
                    ${houseCards}
                  </div>
                </section>
              `
                : ""
            }
          `;
        } catch (error) {
          console.error(error);

          statusEl.textContent =
            error.message ||
            "Something went wrong while looking up representatives.";
        }
      });
    </script>
  </body>
</html>