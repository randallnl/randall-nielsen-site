---
import BaseLayout from "../../layouts/BaseLayout.astro";

const API_BASE =
  import.meta.env.PUBLIC_API_BASE ||
  "https://api.nhdeservesbetter.com";
---

<BaseLayout
  title="My State Rep | NH Deserves Better"
  description="Find your New Hampshire state legislators by address."
>
  <section class="rep-tool">
    <div class="container">
      <p class="eyebrow">My State Rep</p>

      <h1>Find your New Hampshire state legislators.</h1>

      <p class="intro">
        Enter your address to identify your State Senator, your ward-based House
        district, and any floterial House districts connected to your community.
      </p>

      <form id="lookup-form" class="lookup-card card">
        <label for="address">Your full address</label>

        <div class="form-row">
          <input
            id="address"
            name="address"
            type="text"
            placeholder="82 Bobcat Way, Manchester, NH"
            autocomplete="street-address"
            required
          />

          <button type="submit">Find My Reps</button>
        </div>

        <p class="help-text">
          Your address is used to identify your voting districts. It is not stored by this website.
        </p>
      </form>

      <div id="status" class="status-message" aria-live="polite"></div>

      <section id="district-summary" class="district-summary" hidden></section>

      <section id="results" class="results" hidden>
        <div id="senate-section"></div>
        <div id="house-section"></div>
      </section>
    </div>
  </section>

  <script define:vars={{ API_BASE }}>
    const form = document.querySelector("#lookup-form");
    const addressInput = document.querySelector("#address");
    const statusEl = document.querySelector("#status");
    const resultsEl = document.querySelector("#results");
    const districtSummaryEl = document.querySelector("#district-summary");
    const senateSectionEl = document.querySelector("#senate-section");
    const houseSectionEl = document.querySelector("#house-section");

    function escapeHtml(value = "") {
      return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function safeHref(value = "") {
      return String(value || "").replace(/"/g, "%22");
    }

    function formatParty(party) {
      if (!party) return "Party not listed";
      if (party === "R") return "Republican";
      if (party === "D") return "Democrat";
      if (party === "I") return "Independent";
      return party;
    }

    function formatAddress(normalized = {}) {
      return [
        normalized.line1,
        normalized.city,
        normalized.state,
        normalized.zip,
      ]
        .filter(Boolean)
        .join(", ");
    }

    function renderDistrictSummary(data) {
      const civic = data.civic || {};
      const matchedDistricts = data.matchedDistricts || [];
      const prettyAddress = formatAddress(data.normalizedInput || {});

      const place = civic.place?.name || data.normalizedInput?.city || "";
      const ward = civic.ward?.number ? `Ward ${civic.ward.number}` : "";
      const houseDistricts = matchedDistricts
        .filter((d) => d.body === "H")
        .map((d) => d.district_label)
        .filter(Boolean);

      const senateDistrict = civic.senate?.districtLabel || civic.senate?.district || "";

      districtSummaryEl.hidden = false;

      districtSummaryEl.innerHTML = `
        <div class="summary-card card">
          <div>
            <p class="summary-label">Showing results for</p>
            <h2>${escapeHtml(prettyAddress || data.address || "This address")}</h2>
          </div>

          <div class="summary-grid">
            ${
              place
                ? `
                  <div class="summary-item">
                    <span>Community</span>
                    <strong>${escapeHtml(place)}</strong>
                  </div>
                `
                : ""
            }

            ${
              ward
                ? `
                  <div class="summary-item">
                    <span>Ward</span>
                    <strong>${escapeHtml(ward)}</strong>
                  </div>
                `
                : ""
            }

            ${
              senateDistrict
                ? `
                  <div class="summary-item">
                    <span>State Senate</span>
                    <strong>District ${escapeHtml(senateDistrict)}</strong>
                  </div>
                `
                : ""
            }

            ${
              houseDistricts.length
                ? `
                  <div class="summary-item">
                    <span>State House</span>
                    <strong>${escapeHtml(houseDistricts.join(", "))}</strong>
                  </div>
                `
                : ""
            }
          </div>
        </div>
      `;
    }

    function renderRepCard(rep) {
      const name = rep.name || `${rep.firstname || ""} ${rep.lastname || ""}`.trim();

      const photoHtml = rep.photo
        ? `
          <img
            class="rep-photo"
            src="${safeHref(rep.photo)}"
            alt="Photo of ${escapeHtml(name)}"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
          />
          <div class="rep-photo fallback-photo" style="display:none;">
            ${escapeHtml((rep.firstname || name || "NH").slice(0, 1))}
          </div>
        `
        : `
          <div class="rep-photo fallback-photo">
            ${escapeHtml((rep.firstname || name || "NH").slice(0, 1))}
          </div>
        `;

      const emailHtml = rep.email
        ? `<a href="mailto:${escapeHtml(rep.email)}">${escapeHtml(rep.email)}</a>`
        : "Email not listed";

      const phoneHtml = rep.phone
        ? `<a href="tel:${escapeHtml(rep.phone)}">${escapeHtml(rep.phone)}</a>`
        : "Phone not listed";

      return `
        <article class="rep-card card">
          <div class="rep-card-top">
            <div class="photo-wrap">
              ${photoHtml}
            </div>

            <div class="rep-main">
              <h3>${escapeHtml(name)}</h3>

              <div class="rep-meta">
                <span>${escapeHtml(rep.chamber || "Legislator")}</span>
                <span>${escapeHtml(formatParty(rep.party))}</span>
              </div>

              <div class="district-line">
                <strong>District:</strong> ${escapeHtml(rep.district || "Not listed")}
              </div>

              ${
                rep.location_text
                  ? `
                    <div class="location-line">
                      ${escapeHtml(rep.location_text)}
                    </div>
                  `
                  : ""
              }
            </div>
          </div>

          <div class="rep-contact">
            <div>
              <span>Email</span>
              ${emailHtml}
            </div>

            <div>
              <span>Phone</span>
              ${phoneHtml}
            </div>

            ${
              rep.notes
                ? `
                  <div>
                    <span>Notes</span>
                    <p>${escapeHtml(rep.notes)}</p>
                  </div>
                `
                : ""
            }
          </div>
        </article>
      `;
    }

    function renderGroup(title, description, reps) {
      if (!reps || reps.length === 0) {
        return "";
      }

      return `
        <section class="rep-group">
          <div class="group-header">
            <h2>${escapeHtml(title)}</h2>
            <p>${escapeHtml(description)}</p>
          </div>

          <div class="rep-grid">
            ${reps.map(renderRepCard).join("")}
          </div>
        </section>
      `;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const address = addressInput.value.trim();

      if (!address) {
        statusEl.textContent = "Please enter an address.";
        return;
      }

      statusEl.textContent = "Looking up your districts...";
      resultsEl.hidden = true;
      districtSummaryEl.hidden = true;
      senateSectionEl.innerHTML = "";
      houseSectionEl.innerHTML = "";

      try {
        const response = await fetch(`${API_BASE}/reps/lookup`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ address }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Something went wrong.");
        }

        const senateReps = data.groups?.senate || [];
        const houseReps = data.groups?.house || [];
        const allReps = data.representatives || [];

        if (allReps.length === 0) {
          statusEl.textContent = "No representatives found for that address.";
          return;
        }

        statusEl.textContent = "";
        resultsEl.hidden = false;

        renderDistrictSummary(data);

        senateSectionEl.innerHTML = renderGroup(
          "State Senate",
          "Your State Senator represents a larger district in the New Hampshire Senate.",
          senateReps
        );

        houseSectionEl.innerHTML = renderGroup(
          "State House",
          "Your House representatives may include your ward or town district plus a floterial district.",
          houseReps
        );
      } catch (error) {
        console.error(error);
        statusEl.textContent =
          error.message || "Unable to look up representatives.";
      }
    });
  </script>
</BaseLayout>

<style>
  .rep-tool {
    padding: 5rem 0;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2.7rem, 7vw, 5.5rem);
    line-height: 0.95;
    margin: 0 0 1rem;
    max-width: 980px;
  }

  .intro {
    color: var(--muted);
    font-size: 1.2rem;
    max-width: 760px;
  }

  .lookup-card {
    margin-top: 2rem;
  }

  label {
    display: block;
    font-weight: 900;
    margin-bottom: 0.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
  }

  input {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.9rem 1rem;
    font: inherit;
  }

  button {
    border: 0;
    border-radius: 999px;
    padding: 0.9rem 1.25rem;
    background: var(--accent);
    color: white;
    font-weight: 900;
    cursor: pointer;
  }

  button:hover {
    background: var(--accent-dark);
  }

  .help-text {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 0;
  }

  .status-message {
    margin-top: 1.5rem;
    font-weight: 800;
  }

  .district-summary {
    margin-top: 2rem;
  }

  .summary-card {
    display: grid;
    gap: 1.5rem;
  }

  .summary-label {
    color: var(--accent);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 0.25rem;
  }

  .summary-card h2 {
    margin: 0;
    font-size: clamp(1.5rem, 4vw, 2.4rem);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .summary-item {
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.55);
  }

  .summary-item span {
    display: block;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.35rem;
  }

  .summary-item strong {
    font-size: 1rem;
  }

  .results {
    margin-top: 3rem;
  }

  .rep-group + .rep-group {
    margin-top: 3rem;
  }

  .group-header h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0;
  }

  .group-header p {
    color: var(--muted);
    max-width: 720px;
    margin-top: 0.5rem;
  }

  .rep-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .rep-card {
    overflow: hidden;
  }

  .rep-card-top {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 1rem;
    align-items: start;
  }

  .photo-wrap {
    width: 96px;
  }

  .rep-photo {
    width: 96px;
    height: 96px;
    border-radius: 1rem;
    object-fit: cover;
    background: var(--accent);
  }

  .fallback-photo {
    display: grid;
    place-items: center;
    color: white;
    font-weight: 900;
    font-size: 2rem;
  }

  .rep-main h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .rep-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .rep-meta span {
    background: #f3f4ff;
    color: var(--accent);
    border: 1px solid rgba(79, 70, 229, 0.16);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 900;
  }

  .district-line {
    margin-top: 0.75rem;
  }

  .location-line {
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .rep-contact {
    border-top: 1px solid var(--border);
    margin-top: 1rem;
    padding-top: 1rem;
    display: grid;
    gap: 0.75rem;
  }

  .rep-contact div {
    display: grid;
    gap: 0.15rem;
  }

  .rep-contact span {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .rep-contact a {
    color: var(--accent);
    font-weight: 800;
    word-break: break-word;
  }

  .rep-contact p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .summary-grid,
    .rep-grid,
    .form-row {
      grid-template-columns: 1fr;
    }

    button {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .rep-card-top {
      grid-template-columns: 1fr;
    }

    .photo-wrap {
      width: 88px;
    }

    .rep-photo {
      width: 88px;
      height: 88px;
    }
  }
</style>