---
import BaseLayout from "../../layouts/BaseLayout.astro";

const API_BASE = import.meta.env.PUBLIC_API_BASE || "https://api.nhdeservesbetter.com";
---

<BaseLayout
  title="My State Rep | NH Deserves Better"
  description="Find your New Hampshire representatives and understand how they are voting."
>
  <section class="rep-tool">
    <div class="container">
      <p class="eyebrow">My State Rep</p>

      <h1>Find out who represents you.</h1>

      <p class="intro">
        Enter your full address to find your New Hampshire state senator and state representatives.
      </p>

      <form id="rep-form" class="lookup-card card">
        <label for="address">Your full address</label>

        <div class="form-row">
          <input
            id="address"
            name="address"
            type="text"
            placeholder="123 Main St, Manchester, NH"
            autocomplete="street-address"
            required
          />

          <button type="submit">Find My Reps</button>
        </div>

        <p class="help-text">
          Your address is only used to identify your districts.
        </p>
      </form>

      <div id="status" class="status-message" aria-live="polite"></div>

      <section id="district-summary" class="district-summary card" hidden>
        <h2>Districts found</h2>
        <div id="district-list"></div>
      </section>

      <section id="results" class="results" hidden>
        <h2>Your Representatives</h2>

        <div id="senate-section" class="rep-section" hidden>
          <h3>State Senate</h3>
          <div id="senate-list" class="rep-grid"></div>
        </div>

        <div id="house-section" class="rep-section" hidden>
          <h3>State House</h3>
          <div id="house-list" class="rep-grid"></div>
        </div>
      </section>
    </div>
  </section>

  <script define:vars={{ API_BASE }}>
    const form = document.querySelector("#rep-form");
    const addressInput = document.querySelector("#address");
    const statusEl = document.querySelector("#status");

    const districtSummaryEl = document.querySelector("#district-summary");
    const districtListEl = document.querySelector("#district-list");

    const resultsEl = document.querySelector("#results");
    const senateSectionEl = document.querySelector("#senate-section");
    const houseSectionEl = document.querySelector("#house-section");
    const senateListEl = document.querySelector("#senate-list");
    const houseListEl = document.querySelector("#house-list");

    function escapeHtml(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    function safeHref(value) {
      return String(value || "").replace(/"/g, "%22");
    }

    function getInitials(name) {
      return String(name || "NH")
        .split(" ")
        .filter(Boolean)
        .slice(0, 2)
        .map((part) => part[0])
        .join("")
        .toUpperCase() || "NH";
    }

    function renderDistrictSummary(data) {
      const civic = data.civic || {};
      const normalized = data.normalizedInput || null;

      const addressLine = normalized
        ? [normalized.line1, normalized.city, normalized.state, normalized.zip]
            .filter(Boolean)
            .join(", ")
        : "";

      const parts = [];

      if (addressLine) {
        parts.push(`
          <div class="district-row">
            <span>Address</span>
            <strong>${escapeHtml(addressLine)}</strong>
          </div>
        `);
      }

      if (civic.senate?.districtLabel || civic.senate?.district) {
        parts.push(`
          <div class="district-row">
            <span>State Senate District</span>
            <strong>${escapeHtml(civic.senate.districtLabel || civic.senate.district)}</strong>
          </div>
        `);
      }

      if (civic.house?.districtLabel || civic.house?.district) {
        parts.push(`
          <div class="district-row">
            <span>State House District</span>
            <strong>${escapeHtml(civic.house.districtLabel || civic.house.district)}</strong>
          </div>
        `);
      }

      if (civic.place?.name) {
        parts.push(`
          <div class="district-row">
            <span>City/Town</span>
            <strong>${escapeHtml(civic.place.name)}</strong>
          </div>
        `);
      }

      if (civic.ward?.number) {
        parts.push(`
          <div class="district-row">
            <span>Ward</span>
            <strong>${escapeHtml(civic.ward.number)}</strong>
          </div>
        `);
      }

      if (!parts.length) {
        districtSummaryEl.hidden = true;
        districtListEl.innerHTML = "";
        return;
      }

      districtListEl.innerHTML = parts.join("");
      districtSummaryEl.hidden = false;
    }

    function renderRepCard(rep) {
      const name = rep.name || `${rep.firstname || ""} ${rep.lastname || ""}`.trim();
      const chamber = rep.chamber || "";
      const party = rep.party || "";
      const district = rep.district || rep.raw_district || "";
      const location = rep.location_text || "";
      const email = rep.email || "";
      const phone = rep.phone || "";
      const photo = rep.photo || "";
      const notes = rep.notes || "";

      return `
        <article class="rep-card card">
          <div class="rep-header">
            ${
              photo
                ? `<img src="${safeHref(photo)}" alt="Photo of ${escapeHtml(name)}" loading="lazy" onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';" />
                   <div class="photo-placeholder is-hidden">${escapeHtml(getInitials(name))}</div>`
                : `<div class="photo-placeholder">${escapeHtml(getInitials(name))}</div>`
            }

            <div>
              <h4>${escapeHtml(name)}</h4>
              <p>${escapeHtml(chamber)}</p>
            </div>
          </div>

          <div class="rep-meta">
            ${party ? `<span>${escapeHtml(party)}</span>` : ""}
            ${district ? `<span>${escapeHtml(district)}</span>` : ""}
          </div>

          <dl>
            <div>
              <dt>Represents</dt>
              <dd>${location ? escapeHtml(location) : "Not available"}</dd>
            </div>

            <div>
              <dt>Email</dt>
              <dd>
                ${
                  email
                    ? `<a href="mailto:${escapeHtml(email)}">${escapeHtml(email)}</a>`
                    : "Not available"
                }
              </dd>
            </div>

            <div>
              <dt>Phone</dt>
              <dd>
                ${
                  phone
                    ? `<a href="tel:${escapeHtml(phone)}">${escapeHtml(phone)}</a>`
                    : "Not available"
                }
              </dd>
            </div>
          </dl>

          ${
            notes
              ? `<div class="notes">${escapeHtml(notes)}</div>`
              : ""
          }
        </article>
      `;
    }

    function renderRepGroup(sectionEl, listEl, reps) {
      if (!reps || reps.length === 0) {
        sectionEl.hidden = true;
        listEl.innerHTML = "";
        return;
      }

      listEl.innerHTML = reps.map(renderRepCard).join("");
      sectionEl.hidden = false;
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const address = addressInput.value.trim();

      if (!address) {
        statusEl.textContent = "Please enter your full address.";
        return;
      }

      statusEl.textContent = "Looking up your districts and representatives...";
      resultsEl.hidden = true;
      districtSummaryEl.hidden = true;
      senateSectionEl.hidden = true;
      houseSectionEl.hidden = true;
      senateListEl.innerHTML = "";
      houseListEl.innerHTML = "";
      districtListEl.innerHTML = "";

      try {
        const response = await fetch(`${API_BASE}/reps/lookup`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({ address }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || "Something went wrong.");
        }

        const senate = data.groups?.senate || [];
        const house = data.groups?.house || [];
        const allReps = data.representatives || [];

        if (!allReps.length) {
          statusEl.textContent =
            "We found your districts, but no matching legislators were found in the local database yet.";
          renderDistrictSummary(data);
          return;
        }

        statusEl.textContent = "";
        renderDistrictSummary(data);
        renderRepGroup(senateSectionEl, senateListEl, senate);
        renderRepGroup(houseSectionEl, houseListEl, house);
        resultsEl.hidden = false;
      } catch (error) {
        statusEl.textContent =
          error.message || "Unable to look up representatives.";
      }
    });
  </script>
</BaseLayout>

<style>
  .rep-tool {
    padding: 5rem 0;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h1 {
    font-size: clamp(2.7rem, 7vw, 5.5rem);
    line-height: 0.95;
    margin: 0 0 1rem;
    max-width: 900px;
  }

  .intro {
    color: var(--muted);
    font-size: 1.2rem;
    max-width: 720px;
  }

  .lookup-card {
    margin-top: 2rem;
  }

  label {
    display: block;
    font-weight: 900;
    margin-bottom: 0.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.75rem;
  }

  input {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.9rem 1rem;
    font: inherit;
  }

  button {
    border: 0;
    border-radius: 999px;
    padding: 0.9rem 1.25rem;
    background: var(--accent);
    color: white;
    font-weight: 900;
    cursor: pointer;
  }

  button:hover {
    background: var(--accent-dark);
  }

  .help-text {
    color: var(--muted);
    font-size: 0.95rem;
    margin-bottom: 0;
  }

  .status-message {
    margin-top: 1.5rem;
    font-weight: 800;
  }

  .district-summary {
    margin-top: 2rem;
  }

  .district-summary h2,
  .results h2,
  .rep-section h3 {
    margin-top: 0;
  }

  #district-list {
    display: grid;
    gap: 0.75rem;
  }

  .district-row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
  }

  .district-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .district-row span {
    color: var(--muted);
    font-weight: 800;
  }

  .results {
    margin-top: 3rem;
  }

  .rep-section {
    margin-top: 2rem;
  }

  .rep-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .rep-card {
    display: grid;
    gap: 1rem;
  }

  .rep-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .rep-header img,
  .photo-placeholder {
    width: 78px;
    height: 78px;
    border-radius: 999px;
    object-fit: cover;
    background: var(--accent);
    color: white;
    display: grid;
    place-items: center;
    font-weight: 900;
  }

  .photo-placeholder.is-hidden {
    display: none;
  }

  .rep-header h4 {
    margin: 0;
    font-size: 1.35rem;
  }

  .rep-header p {
    margin: 0;
    color: var(--muted);
  }

  .rep-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .rep-meta span {
    background: #f3f4ff;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.85rem;
    font-weight: 900;
  }

  dl {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  dl div {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
  }

  dt {
    color: var(--muted);
    font-weight: 800;
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .notes {
    background: #fef3c7;
    color: #92400e;
    border-radius: 1rem;
    padding: 0.75rem;
    font-weight: 700;
  }

  @media (max-width: 800px) {
    .rep-grid,
    .form-row,
    .district-row {
      grid-template-columns: 1fr;
    }

    button {
      width: 100%;
    }
  }
</style>