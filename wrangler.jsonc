{
	"compatibility_date": "2026-05-08",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "randall-nielsen-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"bucket_name": "nhdeservesbetter-legislator-photos",
			"binding": "nhdeservesbetter-legislator-photos",
			"remote": true
		}
	]
}